generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model group_members {
  group_id  BigInt
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamptz(6)
  groups    groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles  profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
}

model groups {
  id                  BigInt            @id @default(autoincrement())
  name                String            @db.VarChar(50)
  invite_code         String            @unique @db.VarChar(8)
  max_members         Int               @default(10) @db.SmallInt
  owner_id            String            @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  last_shared_at      DateTime?         @db.Timestamptz(6)
  allow_all_exercises Boolean           @default(true)
  color               String            @default("blue") @db.VarChar(20)
  exercises           exercises[]
  group_exercises     group_exercises[]
  group_members       group_members[]
  profiles            profiles          @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  record_shares       record_shares[]
  wake_up_logs        wake_up_logs[]
}

model profiles {
  id                                            String                  @id @db.Uuid
  nickname                                      String                  @db.VarChar(50)
  profile_image                                 String?                 @db.VarChar(500)
  created_at                                    DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime                @default(now()) @db.Timestamptz(6)
  theme                                         theme_type              @default(blue)
  exercise_categories                           exercise_categories[]
  exercise_category_map                         exercise_category_map[]
  exercises                                     exercises[]
  group_members                                 group_members[]
  groups                                        groups[]
  record_comments                               record_comments[]
  record_reactions                              record_reactions[]
  records                                       records[]
  user_exercise_stats                           user_exercise_stats[]
  wake_up_logs_wake_up_logs_sender_idToprofiles wake_up_logs[]          @relation("wake_up_logs_sender_idToprofiles")
  wake_up_logs_wake_up_logs_target_idToprofiles wake_up_logs[]          @relation("wake_up_logs_target_idToprofiles")
}

model record_comments {
  id            BigInt        @id @default(autoincrement())
  share_id      BigInt
  user_id       String        @db.Uuid
  content       String        @db.VarChar(300)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  record_shares record_shares @relation(fields: [share_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles      profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model record_reactions {
  share_id      BigInt
  user_id       String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  record_shares record_shares @relation(fields: [share_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles      profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([share_id, user_id])
}

model record_shares {
  id               BigInt             @id @default(autoincrement())
  record_id        BigInt
  group_id         BigInt
  archived         Boolean            @default(false)
  shared_at        DateTime           @default(now()) @db.Timestamptz(6)
  record_comments  record_comments[]
  record_reactions record_reactions[]
  groups           groups             @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  records          records            @relation(fields: [record_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([record_id, group_id])
  @@index([group_id, shared_at], map: "idx_shares_group_date")
}

model records {
  id              BigInt          @id @default(autoincrement())
  user_id         String          @db.Uuid
  duration_sec    Int?
  comment         String?         @db.VarChar(200)
  start_image_url String          @db.VarChar(500)
  record_date     DateTime        @db.Date
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  end_image_url   String          @db.VarChar
  exercise_id     BigInt
  record_shares   record_shares[]
  exercises       exercises       @relation(fields: [exercise_id], references: [id], onUpdate: NoAction)
  profiles        profiles        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, record_date], map: "idx_records_user_date")
}

model user_exercise_stats {
  user_id       String    @db.Uuid
  total_seconds Int       @default(0)
  total_count   Int       @default(0)
  last_at       DateTime? @db.Timestamptz(6)
  exercise_id   BigInt
  exercises     exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles      profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, exercise_id])
}

model wake_up_logs {
  id                                        BigInt   @id @default(autoincrement())
  group_id                                  BigInt
  sender_id                                 String   @db.Uuid
  target_id                                 String   @db.Uuid
  sent_date                                 DateTime @db.Date
  groups                                    groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_wake_up_logs_sender_idToprofiles profiles @relation("wake_up_logs_sender_idToprofiles", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_wake_up_logs_target_idToprofiles profiles @relation("wake_up_logs_target_idToprofiles", fields: [target_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, sender_id, target_id, sent_date])
}

model exercises {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique(map: "uq_exercises_default_name", where: raw("((owner_id IS NULL) AND (group_id IS NULL))")) @db.VarChar(30)
  owner_id            String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  group_id            BigInt?
  groups              groups?               @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles            profiles?             @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group_exercises     group_exercises[]
  records             records[]
  user_exercise_stats user_exercise_stats[]

  @@unique([owner_id, name], map: "uq_exercises_owner_name", where: raw("(owner_id IS NOT NULL)"))
  @@unique([group_id, name], map: "uq_exercises_group_name", where: raw("(group_id IS NOT NULL)"))
}

model group_exercises {
  group_id    BigInt
  exercise_id BigInt
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups      groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, exercise_id])
  @@index([exercise_id], map: "idx_group_exercises_exercise")
}

model exercise_categories {
  id                    BigInt                  @id @default(autoincrement())
  user_id               String                  @db.Uuid
  name                  String                  @db.VarChar(20)
  color                 String                  @db.VarChar(20)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  profiles              profiles                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise_category_map exercise_category_map[]

  @@unique([user_id, name])
}

model exercise_category_map {
  user_id             String              @db.Uuid
  exercise_name       String              @db.VarChar(30)
  category_id         BigInt
  exercise_categories exercise_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles            profiles            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, exercise_name])
  @@index([category_id], map: "idx_category_map_category")
}

enum theme_type {
  pink
  blue
  lime
  teal
}
