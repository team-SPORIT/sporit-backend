# DB: Railway PostgreSQL (public 스키마만 사용. 인증/Storage는 Supabase)
# - 배포 서버(Railway): Railway 내부 주소 (예: postgresql://postgres:<password>@postgres.railway.internal:5432/railway)
# - 로컬 개발/테스트: 외부(public) 주소 (예: postgresql://postgres:<password>@<name>.proxy.rlwy.net:<port>/railway)
DATABASE_URL=
# (선택) DB 커넥션 풀: 놀고 있는 연결을 닫기까지의 시간(ms, 기본 300000=5분)과 최대 연결 수(기본 10)
DB_POOL_IDLE_MS=300000
DB_POOL_MAX=10

# Supabase (Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Railway Buckets (S3 호환, 비공개): 프로필/기록 이미지 저장소
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# (선택) 이미지 presigned URL 만료 시간(초). 기본 3600
S3_URL_EXPIRES_SEC=3600
# (선택) 접속이 안 될 때 true로 바꿔 시도 (path-style 주소). 기본 false
S3_FORCE_PATH_STYLE=false

# 성능 로그 (NODE_ENV=test에서는 꺼짐)
# (선택) 응답 시간이 이 값(ms) 이상인 요청을 [SLOW] 경고로 표시. 기본 500
SLOW_REQUEST_MS=500
# (선택) 이 값(ms) 이상 걸린 DB 쿼리를 [SLOW QUERY] 경고로 표시. 기본 200
SLOW_QUERY_MS=200
